#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

typedef enum {
  Red,
  Green,
  Blue,
} Color;

typedef struct {
  double x;
  double y;
} Point;

typedef union {
  float f;
  int32_t i;
} FloatOrInt;

/**
 * Alias to a primitive.
 */
typedef uint32_t Length;

/**
 * Alias to a repr(C) struct.
 */
typedef Point Position;

/**
 * Alias to a repr(C) enum.
 */
typedef Color Shade;

/**
 * Alias to a repr(C) union.
 */
typedef FloatOrInt Number;

/**
 * Alias to an alias to a primitive.
 */
typedef uint32_t Size;

/**
 * Alias to an alias to a struct.
 */
typedef Point Coordinate;

typedef struct {
  Position origin;
  Length width;
  Length height;
} Rect;

void use_aliases(Length _len, Position _pos, Shade _shade, Number _num, Size _size, Coordinate _coord, Rect _rect);
