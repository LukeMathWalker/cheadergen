 * A repr(C) struct with private fields.
 */
struct PrivateStruct {
  int32_t x;
  float y;
};

/**
 * A repr(C) union with private fields.
 */
union PrivateUnion {
  int32_t x;
  float y;
};

/**
 * A repr(C) enum with a private-field variant.
 */
enum PrivateEnum_Tag {
  PrivateEnum_A,
  PrivateEnum_B,
};

struct PrivateEnum_A_Body {
  int32_t x;
  float y;
};

struct PrivateEnum {
  enum PrivateEnum_Tag tag;
  union {
    struct PrivateEnum_A_Body a;
  };
};

#ifdef __cplusplus
