#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

typedef struct ListNode ListNode;
typedef struct TreeNode TreeNode;

struct ListNode {
  int32_t value;
  const ListNode *next;
};

typedef enum {
  TreeNode_Leaf,
  TreeNode_Branch,
} TreeNode_Tag;

typedef struct {
  int32_t value;
  TreeNode *left;
  TreeNode *right;
} TreeNode_Branch_Body;

struct TreeNode {
  TreeNode_Tag tag;
  union {
    TreeNode_Branch_Body branch;
  };
};

ListNode use_list(ListNode node);

TreeNode use_tree(TreeNode node);
