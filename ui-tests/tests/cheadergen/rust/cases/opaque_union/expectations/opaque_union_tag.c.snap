#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

/**
 * A non-repr(C) union — opaque, should use `union` tag.
 */
union NonReprC;

/**
 * A repr(C) union with private fields — opaque, should use `union` tag.
 */
union PrivateFields;

void use_non_repr_c(union NonReprC *a);

void use_private(union PrivateFields *a);
