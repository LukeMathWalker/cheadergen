typedef struct {
  bool a;
  int32_t b;
} Foo;

enum Bar_Tag {
  Baz,
  Bazz,
  FooNamed,
  FooParen,
};
typedef uint8_t Bar_Tag;

typedef struct {
  Bar_Tag tag;
  int32_t different;
  uint32_t fields;
} FooNamed_Body;

typedef struct {
  Bar_Tag tag;
  int32_t m0;
  Foo m1;
} FooParen_Body;

typedef union {
  Bar_Tag tag;
  struct {
    Bar_Tag bazz_tag;
    Foo bazz;
  };
