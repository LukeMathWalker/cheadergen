#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

enum Color {
  Red,
  Green,
  Blue,
};

struct Point {
  double x;
  double y;
};

union FloatOrInt {
  float f;
  int32_t i;
};

/**
 * Alias to a primitive.
 */
typedef uint32_t Length;

/**
 * Alias to a repr(C) struct.
 */
typedef struct Point Position;

/**
 * Alias to a repr(C) enum.
 */
typedef enum Color Shade;

/**
 * Alias to a repr(C) union.
 */
typedef union FloatOrInt Number;

/**
 * Alias to an alias to a primitive.
 */
typedef uint32_t Size;

/**
 * Alias to an alias to a struct.
 */
typedef struct Point Coordinate;

/**
 * `repr(transparent)` wrapper around a `repr(C)` struct.
 */
typedef struct Point WrappedPoint;

struct Rect {
  Position origin;
  Length width;
  Length height;
};

#ifdef __cplusplus
extern "C" {
#endif // __cplusplus

void use_aliases(Length _len, Position _pos, Shade _shade, Number _num, Size _size, Coordinate _coord, struct Rect _rect);

/**
 * Aliases and transparent wrappers used behind pointers — exercises that the
 * generator emits the typedef name without a `struct` tag prefix.
 */
void use_alias_ptrs(const Length *_len, const Position *_pos, const Shade *_shade, const Number *_num, const Size *_size, const Coordinate *_coord, const WrappedPoint *_wrapped);

#ifdef __cplusplus
}  // extern "C"
#endif  // __cplusplus
