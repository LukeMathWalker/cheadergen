#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

typedef struct ListNode {
  int32_t value;
  const struct ListNode *next;
} ListNode;

typedef enum TreeNode_Tag {
  Leaf,
  Branch,
} TreeNode_Tag;

typedef struct Branch_Body {
  int32_t value;
  struct TreeNode *left;
  struct TreeNode *right;
} Branch_Body;

typedef struct TreeNode {
  TreeNode_Tag tag;
  union {
    struct Branch_Body branch;
  };
} TreeNode;

struct ListNode use_list(struct ListNode node);

struct TreeNode use_tree(struct TreeNode node);
