#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

/**
 * A repr(C) struct for fn-ptr testing.
 */
struct Pair;

/**
 * A repr(C) fieldless enum for fn-ptr testing.
 */
struct Status;

/**
 * A repr(C) union for fn-ptr testing.
 */
union IntOrFloat;

/**
 * A callback that takes two integers and returns a boolean.
 */
typedef bool (*Predicate)(int32_t, int32_t);

/**
 * A nullable callback (`Option<fn>` should simplify to bare `fn` ptr).
 */
typedef void (*NullableCallback)(uint64_t);

struct Dispatcher {
  void (*on_event)(uint32_t);
  void (*on_error)(int32_t);
};

/**
 * Fn ptr taking and returning a struct by value.
 */
typedef struct Pair (*StructTransform)(struct Pair);

/**
 * Fn ptr taking a struct by pointer.
 */
typedef bool (*StructInspector)(const struct Pair *);

/**
 * Fn ptr taking an enum parameter.
 */
typedef int32_t (*StatusHandler)(struct Status);

/**
 * Nullable fn ptr taking a union by pointer.
 */
typedef void (*NullableUnionCallback)(union IntOrFloat *);

/**
 * Struct with fn-ptr fields that reference complex types.
 */
struct ComplexDispatcher {
  struct Status (*on_pair)(struct Pair);
  struct Pair *(*on_status)(struct Status);
  bool (*on_union)(const union IntOrFloat *);
};

#ifdef __cplusplus
extern "C" {
#endif // __cplusplus

/**
 * Takes a bare function pointer as a parameter.
 */
void register_callback(bool (*cb)(uint8_t));

/**
 * Takes typedef'd function pointer types.
 */
void invoke(Predicate pred, NullableCallback fallback);

/**
 * Uses a struct with function pointer fields.
 */
void dispatch(struct Dispatcher d);

/**
 * Bare fn ptr parameter: struct in, enum out.
 */
void apply_to_pair(struct Status (*f)(struct Pair));

/**
 * Bare fn ptr parameter: union by value in and out.
 */
void transform_union(union IntOrFloat (*f)(union IntOrFloat));

/**
 * Uses all four typedef'd fn ptrs together.
 */
void invoke_complex(StructTransform transform, StructInspector inspect, StatusHandler handle, NullableUnionCallback on_union);

void dispatch_complex(struct ComplexDispatcher d);

#ifdef __cplusplus
}  // extern "C"
#endif  // __cplusplus
