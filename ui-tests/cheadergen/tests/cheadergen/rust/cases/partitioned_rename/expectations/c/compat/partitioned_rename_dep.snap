#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

typedef enum {
  Red,
  COLOR_GREEN,
  Blue,
} Color;

typedef struct {
  int32_t x;
  int32_t y;
} Point;

typedef struct {
  int32_t w;
  int32_t h;
} Dimensions;

typedef enum {
  SHAPE_CIRCLE,
  Rect,
} Shape_Tag;

typedef struct {
  int32_t w;
  int32_t h;
} Rect_Body;

typedef struct {
  Shape_Tag tag;
  union {
    struct {
      float shape_circle;
    };
    Rect_Body rect;
  };
} Shape;
