#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

/**
 * Variants should be prefixed: `Status_Ok`, `Status_Error`, `Status_Pending`.
 */
typedef enum {
  Status_Ok,
  Status_Error,
  Status_Pending,
} Status;

/**
 * Variants should NOT be prefixed (explicit false).
 */
typedef enum {
  A,
  B,
  C,
} Flags;

/**
 * No annotation — uses global default (which is `false` by default).
 */
typedef enum {
  Red,
  Green,
  Blue,
} Color;

Color get_color(void);
