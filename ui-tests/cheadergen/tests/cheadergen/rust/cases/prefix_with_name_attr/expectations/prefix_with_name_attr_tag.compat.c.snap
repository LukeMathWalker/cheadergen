#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

/**
 * Variants should be prefixed: `Status_Ok`, `Status_Error`, `Status_Pending`.
 */
enum Status {
  Status_Ok,
  Status_Error,
  Status_Pending,
};

/**
 * Variants should NOT be prefixed (explicit false).
 */
enum Flags {
  A,
  B,
  C,
};

/**
 * No annotation — uses global default (which is `false` by default).
 */
enum Color {
  Red,
  Green,
  Blue,
};

#ifdef __cplusplus
extern "C" {
#endif // __cplusplus

enum Color get_color(void);

#ifdef __cplusplus
}  // extern "C"
#endif  // __cplusplus
