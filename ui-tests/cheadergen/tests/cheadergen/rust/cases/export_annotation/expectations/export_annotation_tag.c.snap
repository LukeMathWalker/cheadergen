 */
enum Status {
  Ok,
  Error,
  Pending,
};

/**
 * A type without `#[repr(C)]` — should produce an opaque forward declaration.
 */
struct OpaqueHandle;

/**
 * A config struct exported via annotation, not referenced by any FFI function.
