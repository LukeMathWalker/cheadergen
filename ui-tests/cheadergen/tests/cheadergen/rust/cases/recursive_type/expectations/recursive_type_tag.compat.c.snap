#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

struct ListNode {
  int32_t value;
  const struct ListNode *next;
};

enum TreeNode_Tag {
  Leaf,
  Branch,
};

struct Branch_Body {
  int32_t value;
  struct TreeNode *left;
  struct TreeNode *right;
};

struct TreeNode {
  enum TreeNode_Tag tag;
  union {
    struct Branch_Body branch;
  };
};

#ifdef __cplusplus
extern "C" {
#endif // __cplusplus

struct ListNode use_list(struct ListNode node);

struct TreeNode use_tree(struct TreeNode node);

#ifdef __cplusplus
}  // extern "C"
#endif  // __cplusplus
