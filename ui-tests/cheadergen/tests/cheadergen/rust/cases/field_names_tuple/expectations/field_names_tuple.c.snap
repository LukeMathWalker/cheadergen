#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>

/**
 * Tuple struct with custom field names.
 */
typedef struct {
  double x;
  double y;
} Point2D;

/**
 * Tuple struct with default naming (no annotation).
 */
typedef struct {
  uint32_t m0;
  uint32_t m1;
} Pair;

Pair make_pair(uint32_t a, uint32_t b);
